{
  "name": "khalequzzaman17/addetector",
  "description": "Production-quality, framework-agnostic browser ad-block detection and configurable notice renderer for Laravel and PHP.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "adblock",
    "adblock-detector",
    "anti-adblock",
    "php",
    "laravel",
    "browser-detection"
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "illuminate/support": "^10.0 || ^11.0",
    "illuminate/container": "^10.0 || ^11.0"
  },
  "suggest": {
    "illuminate/support": "Required for Laravel ServiceProvider, Facade, and Blade directive integration (^10.0 || ^11.0)."
  },
  "autoload": {
    "psr-4": {
      "AdblockDetector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AdblockDetector\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AdblockDetector\\Laravel\\AdblockDetectorServiceProvider"
      ],
      "aliases": {
        "AdblockDetector": "AdblockDetector\\Laravel\\Facades\\AdblockDetector"
      }
    }
  },
  "scripts": {
    "test": "php tests/run.php && vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
