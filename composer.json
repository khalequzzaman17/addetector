{
  "name": "khalequzzaman17/addetector",
  "description": "Framework-agnostic browser-side ad-block detection and configurable notice renderer for PHP applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "AdblockDetector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AdblockDetector\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
